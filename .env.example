# Скопируйте в .env и подставьте свои значения (.env в .gitignore).

# --- Bootstrap-админ: создаётся при старте, если такого email ещё нет
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please1
APP_ADMIN_FULLNAME='Admin Admin'

# --- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fish_modular
DB_USER=postgres
DB_PASSWORD=postgres
# DB_URL=postgresql+asyncpg://user:pass@host:5432/db   # перекрывает DB_* целиком
# DB_CREATE_TABLES=false   # true = create_all при старте (прототип без миграций)

# --- JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECURITY_JWT_SECRET=change-me-please-change-me-please
# Формат <число><s|m|h|d>
APP_SECURITY_ACCESS_TOKEN_EXPIRATION=15m
APP_SECURITY_REFRESH_TOKEN_EXPIRATION=30d

# Secure-флаг refresh-куки. true для HTTPS; false для локальной разработки по http.
APP_COOKIE_SECURE=false

APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --- Сервис postgres в docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fish_modular
