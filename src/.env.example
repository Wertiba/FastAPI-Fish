# Скопируйте в src/.env и подставьте свои значения (.env в .gitignore).
# Приложение и Alembic читают только переменные окружения процесса: src/.env подхватывают
# `make` (uv run --env-file src/.env) и docker compose (env_file). Тестам .env не нужен.

# --- Админ: создаётся при старте, если такого email ещё нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please1
ADMIN_FULL_NAME='Admin Admin'

# --- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fish
DB_USER=postgres
DB_PASSWORD=postgres
DB_DRIVER=postgresql+asyncpg
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- JWT. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECURITY_JWT_SECRET=change-me-please-change-me-please
# Формат <число><s|m|h|d>
APP_SECURITY_ACCESS_TOKEN_EXPIRATION=15m
APP_SECURITY_REFRESH_TOKEN_EXPIRATION=30d
APP_SECURITY_ALGORITHM=HS256

# Secure-флаг refresh-куки. true для HTTPS; false для локальной разработки по http.
APP_COOKIE_SECURE=false

APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- `make run` (python -m app.run api). В контейнере api слушает 0.0.0.0:8080.
RUN_HOST=0.0.0.0
RUN_PORT=8080

# --- Логи: одна JSON-строка на событие в stdout
LOG_CONSOLE_LEVEL=INFO
LOG_ENV=dev
LOG_SYSTEM=fish
# Необязательно; по умолчанию hostname (ID контейнера в Docker).
# LOG_INST=fish-01

# --- Внешние системы. Все необязательны: пустое значение = локальная замена, и шаблон
# работает с одним Postgres. docker compose подставляет адреса своих контейнеров сам.

# Kafka. Пусто: worker доставляет outbox своим консьюмерам напрямую, без брокера.
# Локально против compose: localhost:29092
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CLIENT_ID=fish
KAFKA_GROUP_ID=fish
WORKER_OUTBOX_POLL_INTERVAL=1.0
WORKER_OUTBOX_BATCH_SIZE=100

# Redis: кеш и распределённые блокировки. Пусто: в памяти процесса (по одной реплике каждого процесса).
# Локально против compose: redis://localhost:6379/0
REDIS_URL=

# S3 / MinIO. Пустой S3_BUCKET: файлы в STORAGE_LOCAL_DIR, без прямых ссылок для клиентов.
# Локально против compose: S3_ENDPOINT_URL=http://localhost:9000, S3_BUCKET=app, ключи minio / minio-password
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_LOCAL_DIR=.storage

# Ollama. Пусто: вызовы LLM отвечают 503, остальное работает. Локально: http://localhost:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
# Сколько генераций параллельно: одна видеокарта тянет немного
OLLAMA_MAX_CONCURRENCY=2

# Telegram. Пусто: исходящие сообщения только логируются, процесс bot не стартует.
TELEGRAM_BOT_TOKEN=

# Push в мобильное приложение (FCM HTTP v1). Пусто: push только логируются.
# Путь к JSON сервисного аккаунта Firebase (Project settings -> Service accounts).
FCM_SERVICE_ACCOUNT_FILE=

# Клиенты с X-App-Version ниже этой получают 426 APP_UPDATE_REQUIRED. Пусто: проверки нет.
MOBILE_MIN_APP_VERSION=

# --- Сервис postgres в docker-compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fish
