# Copy this file to src/.env and fill in real values before running the app or the test suite.
# `app.core.config` (Dynaconf) reads these at import time; python -c "import app.main" and the
# pytest suite will fail without a src/.env populated from this template.

ADMIN_EMAIL=admin@example.com
ADMIN_FULLNAME='Admin Admin'
ADMIN_PASSWORD=change-me-please

# Path to config.yaml used inside the container (leave as-is for local/dev use).
CONFIG_PATH=/app/configs/config.yaml

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fastapi_fish
DB_USER=postgres
DB_PASSWORD=change-me-please

# Secret used to sign JWTs - generate your own, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
APP_SECURITY_JWT_SECRET=change-me-please

# Format: <number><unit>, unit is one of s/m/h/d (e.g. "15m", "30d")
APP_SECURITY_ACCESS_TOKEN_EXPIRATION=15m
APP_SECURITY_REFRESH_TOKEN_EXPIRATION=30d

# Secure flag on the refreshToken cookie. Keep `true` for any real deployment (HTTPS);
# set to `false` only for local dev over plain HTTP (e.g. the bundled docker-compose.yml).
APP_COOKIE_SECURE=true

# docker-compose Postgres service credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=fastapi_fish
