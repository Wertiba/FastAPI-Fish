from uuid import UUID

from dishka.integrations.fastapi import DishkaRoute, FromDishka
from fastapi import APIRouter, Response, status

from app.application.pagination import Pagination
from app.application.{{plural}}.interactors import (
    Create{{Entity}},
    Delete{{Entity}},
    Get{{Entity}},
    List{{Plural}},
    Update{{Entity}},
)
from app.application.{{plural}}.schemas import {{Entity}}CreateBody, {{Entity}}UpdateBody
from app.infra.metrics import track
from app.presentation.http.api.v1.dependencies import CurrentUserDep, PaginationDep
from app.presentation.http.paginated import Page
from app.presentation.http.schemas.{{entity}} import {{Entity}}ReadResponse

router = APIRouter(prefix="/{{url}}", tags=["{{Tag}}"], route_class=DishkaRoute)


@router.get("", response_model=Page[{{Entity}}ReadResponse], status_code=status.HTTP_200_OK)
async def get_{{plural}}(
    user: CurrentUserDep, interactor: FromDishka[List{{Plural}}], pagination: PaginationDep
) -> Page[{{Entity}}ReadResponse]:
    page = await interactor(user.id, Pagination(page=pagination.page, size=pagination.size))
    return Page[{{Entity}}ReadResponse].model_validate(page, from_attributes=True)


@router.post("", response_model={{Entity}}ReadResponse, status_code=status.HTTP_201_CREATED)
async def create_{{entity}}(
    user: CurrentUserDep, interactor: FromDishka[Create{{Entity}}], body: {{Entity}}CreateBody, response: Response
) -> {{Entity}}ReadResponse:
    created = await interactor(user.id, body)
    track("{{entity}}", "created")
    response.headers["Location"] = f"/api/v1/{{url}}/{created.id}"
    return {{Entity}}ReadResponse.model_validate(created, from_attributes=True)


@router.get("/{{{entity}}_id}", response_model={{Entity}}ReadResponse, status_code=status.HTTP_200_OK)
async def get_{{entity}}(
    user: CurrentUserDep, {{entity}}_id: UUID, interactor: FromDishka[Get{{Entity}}]
) -> {{Entity}}ReadResponse:
    return {{Entity}}ReadResponse.model_validate(await interactor(user.id, {{entity}}_id), from_attributes=True)


@router.patch("/{{{entity}}_id}", response_model={{Entity}}ReadResponse, status_code=status.HTTP_200_OK)
async def update_{{entity}}(
    user: CurrentUserDep, {{entity}}_id: UUID, interactor: FromDishka[Update{{Entity}}], body: {{Entity}}UpdateBody
) -> {{Entity}}ReadResponse:
    return {{Entity}}ReadResponse.model_validate(await interactor(user.id, {{entity}}_id, body), from_attributes=True)


@router.delete("/{{{entity}}_id}", response_model=None, status_code=status.HTTP_204_NO_CONTENT)
async def delete_{{entity}}(user: CurrentUserDep, {{entity}}_id: UUID, interactor: FromDishka[Delete{{Entity}}]) -> None:
    await interactor(user.id, {{entity}}_id)
    track("{{entity}}", "deleted")
