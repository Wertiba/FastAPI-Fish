@dataclass
class _{{Entity}}Context:
    uow: UnitOfWork
    {{entity}}_gateway: {{Entity}}Gateway
    user_gateway: UserGateway

    async def _require_{{entity}}(self, user_id: UUID, {{entity}}_id: UUID) -> {{Entity}}:
        """The owner and admins have access; everyone else gets 403."""
        {{entity}} = await self.{{entity}}_gateway.get_by_id({{entity}}_id)
        if {{entity}} is None:
            raise {{Entity}}NotFoundError
        if {{entity}}.owner_id != user_id and not await is_admin(self.user_gateway, user_id):
            raise ForbiddenError
        return {{entity}}


class List{{Plural}}(_{{Entity}}Context):
    async def __call__(self, user_id: UUID, pagination: Pagination) -> Page[{{Entity}}]:
        """A user sees their own items, an admin sees everything."""
        owner_id = None if await is_admin(self.user_gateway, user_id) else user_id
        items = await self.{{entity}}_gateway.get_all(offset=pagination.offset, limit=pagination.limit, owner_id=owner_id)
        total = await self.{{entity}}_gateway.count(owner_id=owner_id)
        return Page.build(items=items, total=total, pagination=pagination)


class Get{{Entity}}(_{{Entity}}Context):
    async def __call__(self, user_id: UUID, {{entity}}_id: UUID) -> {{Entity}}:
        return await self._require_{{entity}}(user_id, {{entity}}_id)


class Create{{Entity}}(_{{Entity}}Context):
    async def __call__(self, user_id: UUID, data: {{Entity}}CreateBody) -> {{Entity}}:
        {{entity}} = {{Entity}}(**data.model_dump(), owner_id=user_id)
        await self.uow.add({{entity}})
        await self.uow.commit()
        return {{entity}}


class Update{{Entity}}(_{{Entity}}Context):
    async def __call__(self, user_id: UUID, {{entity}}_id: UUID, data: {{Entity}}UpdateBody) -> {{Entity}}:
        {{entity}} = await self._require_{{entity}}(user_id, {{entity}}_id)
        if changes := data.model_dump(exclude_unset=True):
            apply_changes({{entity}}, changes)
        await self.uow.commit()
        return {{entity}}


class Delete{{Entity}}(_{{Entity}}Context):
    async def __call__(self, user_id: UUID, {{entity}}_id: UUID) -> None:
        {{entity}} = await self._require_{{entity}}(user_id, {{entity}}_id)
        await self.uow.delete({{entity}})
        await self.uow.commit()
