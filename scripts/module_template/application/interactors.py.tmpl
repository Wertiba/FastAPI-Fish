from dataclasses import dataclass
from typing import Any

from app.shared.application.changes import apply_changes
from app.shared.application.pagination import Page, Pagination
from app.modules.{{plural}}.application.ports import {{Entity}}Gateway
from app.shared.application.ports.unit_of_work import UnitOfWork
from app.modules.{{plural}}.application.dto import {{Entity}}CreateData, {{Entity}}Result, {{Entity}}UpdateData
from app.modules.{{plural}}.domain.entity import {{Entity}}
